# Generate independent private keys before starting. See docs/SECURITY_UPGRADE.md.
DJANGO_SECRET_KEY=
LINDEPLOY_CREDENTIAL_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=UTC

# Database
# Set USE_SQLITE=True for quick local setup, or configure PostgreSQL below.
USE_SQLITE=True
DB_NAME=auto_k8s
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_DEFAULT_QUEUE=lindeploy

# Ansible execution
ANSIBLE_RUNNER_BACKEND=wsl
ANSIBLE_WSL_DISTRO=Ubuntu
# Leave empty to use backend/backend/Playbooks automatically.
ANSIBLE_REPO_ROOT=
ANSIBLE_TIMEOUT=15
ANSIBLE_HOST_KEY_CHECKING=False
ANSIBLE_SSH_ARGS=-C -o ControlMaster=auto -o ControlPersist=60s -o ConnectTimeout=15 -o ConnectionAttempts=1 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
OPENSHIFT_SECRET_ENCRYPTION_KEY=
OPENSHIFT_SECRET_TTL_SECONDS=1800
OPENSHIFT_RED_HAT_OFFLINE_TOKEN=
OPENSHIFT_DEFAULT_VERSION=4.20
# Cancel old queued work; running hosts stay reserved until the worker confirms stop.
INSTALLATION_PRE_EXECUTION_STALE_SECONDS=900

# Optional smart LAN mirror. One pull-through registry cache is required for
# each upstream registry because OCI registries use separate namespaces.
LINDEPLOY_MIRROR_ENABLED=False
LINDEPLOY_MIRROR_CACHE_REQUIRED=False
LINDEPLOY_KUBERNETES_PROFILE_ID=kubernetes-v1.36.3-amd64-all-supported
LINDEPLOY_K3S_PROFILE_ID=k3s-v1.36.3+k3s1-amd64-all-supported
LINDEPLOY_MIRROR_ALLOW_INSECURE_HTTP=False
LINDEPLOY_REGISTRY_MIRRORS_JSON={"registry.k8s.io":"https://mirror.example.internal:5001","quay.io":"https://mirror.example.internal:5002","docker.io":"https://mirror.example.internal:5003"}
# PEM CA used to sign the mirror TLS certificate. Leave empty for a certificate
# already trusted by every target.
LINDEPLOY_MIRROR_CA_CERTIFICATE_FILE=
# Optional cache for distribution BaseOS/AppStream or APT archive packages.
# This is independent from the OCI image cache and falls back to the target's
# official repositories when the local transaction fails.
LINDEPLOY_SYSTEM_PACKAGE_CACHE_ENABLED=False
LINDEPLOY_PACKAGE_MIRROR_BASE_URL=https://mirror.example.internal:8443/cache
# Cached artifact/package endpoints exposed by the same mirror server.
LINDEPLOY_K3S_INSTALL_SCRIPT_URL=
LINDEPLOY_K3S_CHANNEL_URL=
LINDEPLOY_K3S_ARTIFACT_URL=
LINDEPLOY_CALICO_MANIFEST_URL=
LINDEPLOY_CONTAINERD_RPM_BASEURL=
LINDEPLOY_CONTAINERD_RPM_GPGKEY=
LINDEPLOY_CONTAINERD_APT_REPO_URL=
LINDEPLOY_CONTAINERD_APT_KEY_URL=
LINDEPLOY_KUBERNETES_RPM_BASEURL=
LINDEPLOY_KUBERNETES_RPM_GPGKEY=
LINDEPLOY_KUBERNETES_APT_REPO_URL=
LINDEPLOY_KUBERNETES_APT_KEY_URL=
# Celery Beat checks stable Kubernetes and K3s releases at this interval. A new
# version is activated only after its mirror prewarm completes successfully.
LINDEPLOY_MIRROR_PREWARM_INTERVAL_HOURS=24
# Maximum duration of one complete Kubernetes + K3s prewarm operation.
LINDEPLOY_MIRROR_PREWARM_TIMEOUT_SECONDS=10800
OPENSHIFT_MIRROR_REGISTRY=registry.lab.test:8443
OPENSHIFT_MIRROR_VERSION=4.20.3
OPENSHIFT_MIRROR_USERNAME=init
# Set locally; never commit the Quay password.
OPENSHIFT_MIRROR_PASSWORD=
OPENSHIFT_MIRROR_STORAGE_PATH=/home/lindeploy/openshift-mirror
