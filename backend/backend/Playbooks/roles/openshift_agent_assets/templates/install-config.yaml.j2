apiVersion: v1
baseDomain: {{ base_dns_domain }}
metadata:
  name: {{ cluster_name }}
compute:
  - name: worker
    replicas: 0
controlPlane:
  name: master
  replicas: 1
  architecture: {{ 'amd64' if cpu_architecture == 'x86_64' else cpu_architecture }}
platform:
  none: {}
networking:
  networkType: OVNKubernetes
  machineNetwork:
    - cidr: {{ libvirt_network_cidr }}
  clusterNetwork:
    - cidr: {{ cluster_network_cidr }}
      hostPrefix: {{ cluster_network_host_prefix }}
  serviceNetwork:
    - {{ service_network_cidr }}
pullSecret: '{{ ((pull_secret | from_json) | combine({"auths": (pull_secret | from_json).auths | combine({openshift_mirror_registry: {"auth": (mirror_username ~ ":" ~ mirror_password) | b64encode}}, recursive=True)}, recursive=True)) | to_json | replace("'", "''") }}'
sshKey: '{{ ssh_public_key | replace("'", "''") }}'
fips: {{ openshift_fips_enabled | bool | lower }}
additionalTrustBundle: |
{{ (openshift_effective_mirror_ca_bundle ~ '\n' ~ additional_trust_bundle | default('')) | trim | indent(2, true) }}
imageContentSources:
  - source: quay.io/openshift-release-dev/ocp-release
    mirrors:
      - {{ openshift_mirror_registry }}/openshift/release-images
  - source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
    mirrors:
      - {{ openshift_mirror_registry }}/openshift/release
