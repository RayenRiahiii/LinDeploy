# 12 GiB limit for raw artifacts. OCI registry caches use their own volumes and
# expire unused proxy content according to the registry configuration.
MIRROR_CACHE_MAX_BYTES=12884901888
MIRROR_CACHE_RESERVED_FREE_BYTES=2147483648
MIRROR_CACHE_MAX_OBJECT_BYTES=4294967296
MIRROR_MAX_WORKERS=32
MIRROR_UPSTREAM_TIMEOUT=900
# Repository indexes are refreshed hourly. If the upstream is temporarily
# unavailable, the last verified cached index remains available.
MIRROR_METADATA_TTL=3600
# Revalidate cached RPM/DEB payload identity with a lightweight HEAD request.
# This prevents stale files when an upstream replaces content under the same URL.
MIRROR_PAYLOAD_REVALIDATE_TTL=300
