{
  "distSpecVersion": "1.1.1",
  "storage": {"rootDirectory": "/var/lib/zot", "dedupe": true, "gc": true},
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"],
    "readTimeout": "10m",
    "writeTimeout": "10m"
  },
  "log": {"level": "info"},
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [{
        "urls": ["https://quay.io"],
        "onDemand": true,
        "tlsVerify": true,
        "preserveDigest": true,
        "maxRetries": 2,
        "retryDelay": "5s"
      }]
    }
  }
}
